  "diagnostic_tool": {
    "name": "check_connection",
    "title": "Check Database Connectivity",
    "description": "Diagnose fresh connections: single/default or explicitly permitted all scope.\n\nscope='single' (default) checks connection_id, or the default when omitted.\nscope='all' checks every configured alias and requires an omitted/null alias.\nUse all only when requested and permitted, never because an alias is missing.\nPass a resolved target explicitly. For unresolved purposes, ambiguous references\nor conflicting restrictions, only list_connections() may offer candidates;\nask and wait before diagnostics. Prohibitions include connection checks.\nA broad request limited to one resolved alias/default checks only that target\nand reports others unchecked; if partial checks are rejected, ask and wait.\nUse on request or after an operation reports a connection failure.\nDo not call it as a routine prerequisite before queries.\n\nBoth scopes use disposable worker-owned connections, not business adapters.\nChecks prove neither business pool health, tables, Skill readiness nor write access.\nSQLite files use mode=ro; WAL auxiliary files may involve filesystem writes.\n:memory: checks a fresh temporary database, not business data.\nThe report's scope/counts/all_connected cover selected aliases only.\nconnected/failed are confirmed results; timeout/not_checked use connected=null.\nThe 30-second waiting budget shortens for a smaller MCP timeout; it cannot\nterminate driver calls. Any new diagnostic is busy until prior cleanup ends.\nBusy/stopped/disabled requests are MCP tool errors, not report statuses.\ncleanup_failed preserves connectivity but disables diagnostics until process\nrestart. False means no observed cleanup failure at report time, not proven release.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Configured alias for scope='single'; omit or use null for the default. Pass an already resolved target explicitly. Must be omitted or null for scope='all'."
        },
        "scope": {
          "default": "single",
          "description": "single checks one alias or the default; all explicitly checks every configured alias.",
          "enum": [
