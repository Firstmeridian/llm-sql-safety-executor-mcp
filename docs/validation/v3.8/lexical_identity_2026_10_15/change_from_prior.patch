@@ -8,10 +8,23 @@
 # Safe read-only SQL statement types
 SAFE_SQL_TYPES = {"SELECT", "SHOW", "DESCRIBE", "DESC", "EXPLAIN"}
 _NESTED_WRITE_DML_TYPES = {"INSERT", "UPDATE", "DELETE", "REPLACE", "MERGE"}
+_ASCII_SQL_CASE = str.maketrans("abcdefghijklmnopqrstuvwxyz", "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
+
+
+def sql_token_upper(token: sqlparse.sql.Token) -> str:
+    """Compare SQL vocabulary without Unicode-folding a business name.
+
+    sqlparse's normalized keyword value already uses Unicode upper(). Read
+    the original spelling, including when its lexer labeled a name a keyword.
+    This helper neither validates syntax nor establishes relation identity.
+    """
+    return token.value.translate(_ASCII_SQL_CASE)
+
+
 _EXECUTING_EXPLAIN_PATTERN = re.compile(
     r"^(?:EXPLAIN|DESCRIBE|DESC)\s+"
     r"(?:ANALYZE\b|\([^)]*\bANALYZE\b[^)]*\))",
-    re.IGNORECASE,
+    re.IGNORECASE | re.ASCII,
 )
 
 _MYSQL_DASH_COMMENT_WHITESPACE = " \t\r\n\f\v"
