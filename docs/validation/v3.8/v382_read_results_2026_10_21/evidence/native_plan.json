{
  "scope": "Frozen post-owner-restart native read-only checks; existing aliases, no new fixtures/grants/configuration",
  "checks": [
    {
      "id": "sqlite:constant",
      "tool": "query",
      "arguments": {
        "connection_id": "sqlite_features_sqlite",
        "sql": "SELECT 1 AS n"
      },
      "expected": {
        "success": true,
        "data": [
          {
            "n": 1
          }
        ]
      }
    },
    {
      "id": "sqlite:duplicate",
      "tool": "query",
      "arguments": {
        "connection_id": "sqlite_features_sqlite",
        "sql": "SELECT 7 AS n,99 AS n"
      },
      "expected": {
        "success": false,
        "error_code": "duplicate_result_columns"
      }
    },
    {
      "id": "sqlite:unique",
      "tool": "query",
      "arguments": {
        "connection_id": "sqlite_features_sqlite",
        "sql": "SELECT 7 AS n,99 AS other_n"
      },
      "expected": {
        "success": true,
        "data": [
          {
            "n": 7,
            "other_n": 99
          }
        ]
      }
    },
    {
      "id": "sqlite:binary",
      "tool": "query",
      "arguments": {
        "connection_id": "sqlite_features_sqlite",
        "sql": "SELECT X'00FF' AS payload"
      },
      "expected": {
        "success": true,
        "data": [
          {
            "payload": {
              "$type": "binary",
              "encoding": "base64",
              "data": "AP8="
            }
          }
        ]
      }
    },
    {
      "id": "sqlite:binary_utf8",
      "tool": "query",
      "arguments": {
        "connection_id": "sqlite_features_sqlite",
