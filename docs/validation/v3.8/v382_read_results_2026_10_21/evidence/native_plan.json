      },
      "expected": {
        "success": true,
        "data": [
          {
            "payload": {
              "$type": "binary",
              "encoding": "base64",
              "data": "YWJj"
            }
          }
        ]
      }
    },
    {
      "id": "sqlite:first_row",
      "tool": "query",
      "arguments": {
        "connection_id": "sqlite_features_sqlite",
