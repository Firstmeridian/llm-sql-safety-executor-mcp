# =============================================================================
# Database Configuration
# 数据库配置
# =============================================================================
# Copy this file to .env and update with your actual database settings
# 将本文件复制为 .env，并根据实际数据库修改配置

# Database Type: 'mysql' (default) or 'sqlite'
# 数据库类型：'mysql'（默认）或 'sqlite'
# MySQL: Full INFORMATION_SCHEMA support, production-ready
# MySQL：支持完整的 INFORMATION_SCHEMA，适合生产环境
# SQLite: File-based or in-memory, ideal for local development/testing
# SQLite：支持文件数据库或内存数据库，适合本地开发和测试
DB_TYPE=mysql

# -----------------------------------------------------------------------------
# MySQL Configuration (used when DB_TYPE=mysql)
# MySQL 配置（当 DB_TYPE=mysql 时使用）
# -----------------------------------------------------------------------------
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_NAME=your_db_name

# -----------------------------------------------------------------------------
# SQLite Configuration (used when DB_TYPE=sqlite)
# SQLite 配置（当 DB_TYPE=sqlite 时使用）
# -----------------------------------------------------------------------------
# Path to SQLite database file, or ':memory:' for in-memory database
# SQLite 数据库文件路径；设置为 ':memory:' 时使用内存数据库
# Examples:
# 示例：
#   SQLITE_DATABASE_PATH=./data/myapp.db
#   SQLITE_DATABASE_PATH=/absolute/path/to/database.sqlite
#   SQLITE_DATABASE_PATH=:memory:
SQLITE_DATABASE_PATH=./sample_data/demo.db

# SQLite query timeout progress handler interval
# SQLite 查询超时的 progress handler 检查间隔
# Lower value = more responsive timeout, higher CPU overhead
# 数值越小，超时响应越快，但 CPU 开销越高
# Recommended: 100-1000 (100 = ~10μs overhead per check)
# 建议范围：100-1000（100 大约表示每次检查开销为 10 微秒）
# Only applies when DB_TYPE=sqlite
# 仅对 DB_TYPE=sqlite 生效
# SQLITE_PROGRESS_HANDLER_INTERVAL=100

# =============================================================================
# Named Database Connections (v3.5, optional)
# 命名数据库连接（v3.5，可选）
# =============================================================================

# Leave DB_CONNECTIONS unset to keep the legacy single-connection behavior above.
# 不设置 DB_CONNECTIONS 时，保持上面的 legacy 单连接行为。
# In legacy mode, DB_<CONNECTION_ID>_* variables below and DEFAULT_DB_CONNECTION
# are ignored even if present; they become active only when DB_CONNECTIONS is set.
# 在 legacy 模式下，即使存在下面的 DB_<CONNECTION_ID>_* 和
# DEFAULT_DB_CONNECTION，也会被忽略；只有设置 DB_CONNECTIONS 后才会生效。
# When set, tools accept an optional connection_id and the server maintains one
# SQLAlchemy Engine/SQLite StaticPool per configured id. Connection ids must be
# lowercase letters, digits, or underscores and must start with a letter.
# 设置后，工具可以接收可选的 connection_id，服务端为每个配置 ID 维护一个
# SQLAlchemy Engine/SQLite StaticPool。连接 ID 必须由小写字母、数字或下划线组成，
# 并且必须以字母开头。
# Prefer semantic ids such as mysql, analytics, or ops. Avoid using "default"
# as a connection id unless it is truly meaningful in your deployment: the
# actual default is selected by DEFAULT_DB_CONNECTION.
# 建议使用 mysql、analytics、ops 等有业务含义的 ID。除非部署场景确实需要，
# 不建议使用 "default" 作为连接 ID；实际默认连接由 DEFAULT_DB_CONNECTION 选择。
# Tools never accept arbitrary DSNs from the model.
# 工具不会接受模型传入的任意 DSN。
# DB_CONNECTIONS=mysql,analytics
# DEFAULT_DB_CONNECTION=mysql

# Per-connection variables use DB_<CONNECTION_ID>_<SETTING>. The default
# connection may still fall back to the legacy DB_TYPE/DB_USER/... variables.
# 每个连接使用 DB_<CONNECTION_ID>_<SETTING> 变量。默认连接为了兼容旧配置，
# 仍可能回退到 legacy 的 DB_TYPE/DB_USER/... 变量。
# For clarity, write explicit per-connection values in multi-connection mode.
# 在多连接模式下，建议显式写出每个连接的配置，便于审计和排查。
# Non-default connections should also be explicit: omitted fields may use process
# defaults inherited at startup, which can be surprising in mixed deployments.
# 非默认连接也建议显式配置：省略字段时可能继承进程启动时的默认值，
# 在混合数据库部署中容易产生误解。
# DB_MYSQL_TYPE=mysql
# DB_MYSQL_USER=your_db_user
# DB_MYSQL_PASSWORD=your_db_password
# DB_MYSQL_HOST=your_db_host
# DB_MYSQL_NAME=your_db_name
# DB_MYSQL_QUERY_TIMEOUT_SECONDS=30
# DB_MYSQL_CONNECT_TIMEOUT_SECONDS=10
# DB_MYSQL_ALLOW_UNION=0
# DB_MYSQL_ALLOWED_TABLES=products,orders,customers
# DB_MYSQL_ALLOW_MUTATIONS=1
# DB_MYSQL_MUTATION_SKILLS=update-order-status

# DB_ANALYTICS_TYPE=sqlite
# DB_ANALYTICS_SQLITE_DATABASE_PATH=./sample_data/demo.db
# DB_ANALYTICS_SQLITE_PROGRESS_HANDLER_INTERVAL=100
# DB_ANALYTICS_QUERY_TIMEOUT_SECONDS=30
# DB_ANALYTICS_ALLOW_UNION=0
# DB_ANALYTICS_ALLOWED_TABLES=orders
# DB_ANALYTICS_ALLOW_MUTATIONS=0
# DB_ANALYTICS_MUTATION_SKILLS=update-order-status

# v3.6 connection scope:
# v3.6 连接作用域说明：
# - Core read-only tools and query skills support connection_id.
# - 核心只读工具和查询 Skill 支持 connection_id。
# - Without SKILLS_ALLOW_MUTATION_CONNECTIONS, mutation skills remain limited
#   to the default connection for compatibility.
# - 未设置 SKILLS_ALLOW_MUTATION_CONNECTIONS 时，为保持兼容，Mutation Skill
#   仍仅限默认连接。
# - With SKILLS_ALLOW_MUTATION_CONNECTIONS set, every authorized target also
#   requires DB_<ID>_ALLOW_MUTATIONS=1 and a non-empty
#   DB_<ID>_MUTATION_SKILLS allowlist. Omitted values deny writes.
# - 设置 SKILLS_ALLOW_MUTATION_CONNECTIONS 后，每个授权目标还必须设置
#   DB_<ID>_ALLOW_MUTATIONS=1，并配置非空的 DB_<ID>_MUTATION_SKILLS；省略值表示拒绝写入。
# - Per-connection policy covers ALLOW_UNION, ALLOWED_TABLES, mutation policy,
#   and timeouts. Result-size limits remain process-wide.
# - 连接级 policy 覆盖 ALLOW_UNION、ALLOWED_TABLES、Mutation policy 和超时；
#   结果大小限制仍然是进程级配置。
# - list_connections returns ids/db_type/policy summaries only; it does not
#   expose DSNs, hosts, file paths, users, passwords, or credentials.
# - list_connections 只返回连接 ID、数据库类型和 policy 摘要，不暴露 DSN、host、
#   文件路径、用户名、密码或其它凭据。

# Optional: MCP Server Configuration
# 可选：MCP 服务配置
# MCP_HOST=localhost
# MCP_PORT=8000

# Feature Toggle for Schema/Sample Tools (1=enabled, 0=disabled)
# Schema/Sample 工具功能开关（1=启用，0=禁用）
ENABLE_SCHEMA_TOOLS=1

# Enable get_table_summary tool with optional exact COUNT(*) (1=enabled, 0=disabled)
# 启用 get_table_summary 工具及可选的精确 COUNT(*)（1=启用，0=禁用）
# Default: 0 (disabled) - describe_table already provides estimated row counts
# 默认值：0（禁用）——describe_table 已经提供估算行数
# Enable when exact counts via COUNT(*) are needed for specific workflows
# 只有特定工作流确实需要 COUNT(*) 精确计数时才启用
# WARNING: COUNT(*) can be slow on large tables (full table scan)
# 警告：大型表执行 COUNT(*) 可能较慢，因为可能需要全表扫描
ENABLE_TABLE_SUMMARY=0

# Large table threshold for is_large flag and query recommendations
# 用于 is_large 标志和查询建议的大表阈值
# Tables exceeding this row count trigger LIMIT/aggregation hints
# 超过此行数的表会触发 LIMIT/聚合提示
# Reference: MySQL InnoDB full table scan cost considerations
# 参考：MySQL InnoDB 全表扫描成本相关注意事项
LARGE_TABLE_THRESHOLD=1000

# =============================================================================
# Security Configuration (Recommended for Production)
# 安全配置（生产环境建议设置）
# =============================================================================

# P0: Timeout Settings (in seconds)
# P0：超时设置（单位：秒）
# Read queries use database-specific query timeout controls.
# 只读查询使用各数据库适配器的查询超时控制。
# MySQL mutations reuse this value for InnoDB row-lock waits; long-running
# DML CPU/IO work may still need driver or deployment-side statement controls.
# MySQL Mutation 使用该值控制 InnoDB 行锁等待；长时间运行的 DML CPU/IO 工作
# 仍可能需要驱动层或部署层的语句控制。
# Reference: Microsoft Azure best practices - "Set appropriate timeouts"
# 参考：Microsoft Azure 最佳实践——设置合适的超时时间
QUERY_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=10

# MCP foreground tool timeout in seconds (0=disable FastMCP timeout).
# MCP 前台工具超时时间（单位：秒；0=禁用 FastMCP 超时）。
# Keep this higher than QUERY_TIMEOUT_SECONDS because schema tools may perform
# multiple metadata reads in one tool call.
# 建议高于 QUERY_TIMEOUT_SECONDS，因为 Schema 工具一次调用可能执行多次元数据读取。
MCP_TOOL_TIMEOUT_SECONDS=120

# P1: Table Allowlist (comma-separated, case-insensitive)
# P1：表白名单（逗号分隔，不区分大小写）
# Only allow access to specific tables - leave empty to allow all
# 仅允许访问指定表；留空表示允许所有表
# Example: ALLOWED_TABLES=products,orders,customers,categories
# 示例：ALLOWED_TABLES=products,orders,customers,categories
# Reference: Microsoft "Least Privilege Principle"
# 参考：Microsoft“最小权限原则”
# ALLOWED_TABLES=

# P2: UNION Query Policy
# P2：UNION 查询策略
# IMPORTANT: UNION requires DUAL configuration to enable:
# 重要：启用 UNION 需要同时满足以下两项配置：
#   1. ALLOW_UNION=1 (enable UNION syntax)
#   1. ALLOW_UNION=1（启用 UNION 语法）
#   2. ALLOWED_TABLES=table1,table2 OR ALLOWED_TABLES=* (specify allowed tables)
#   2. ALLOWED_TABLES=table1,table2 或 ALLOWED_TABLES=*（明确允许访问的表）
# If ALLOW_UNION=1 but ALLOWED_TABLES is empty, UNION will still be blocked.
# 如果 ALLOW_UNION=1 但 ALLOWED_TABLES 为空，UNION 仍会被阻止。
# Reference: OWASP Defense-in-Depth, OpenAI "minimize tool calls"
# 参考：OWASP 纵深防御、OpenAI“减少工具调用”建议
ALLOW_UNION=0
# ALLOWED_TABLES=*

# =============================================================================
# Skills Extension (v3.0)
# Skills 扩展（v3.0）
# =============================================================================

# Master switch: enable Skills extension layer (1=enabled, 0=disabled)
# 主开关：启用 Skills 扩展层（1=启用，0=禁用）
# When disabled, no skills tools are registered — zero overhead
# 禁用时不会注册任何 Skills 工具，不产生额外运行开销
ENABLE_SKILLS=0

# Allow mutation (write) skills (1=enabled, 0=disabled)
# 允许 Mutation（写入）Skill（1=启用，0=禁用）
# Requires ENABLE_SKILLS=1. When disabled, only query skills are available.
# 需要先设置 ENABLE_SKILLS=1；禁用时只能使用查询 Skill。
SKILLS_ALLOW_MUTATIONS=0

# Optional v3.6 mutation connection policy. Setting this enables strict mode:
# every listed id must exist in DB_CONNECTIONS and must separately set
# DB_<ID>_ALLOW_MUTATIONS=1 plus DB_<ID>_MUTATION_SKILLS.
# Omit this variable to keep mutation skills limited to the default connection.
# 可选的 v3.6 Mutation 连接策略。设置后启用严格模式：列表中的每个 ID 都必须存在于
# DB_CONNECTIONS，并分别设置 DB_<ID>_ALLOW_MUTATIONS=1 和 DB_<ID>_MUTATION_SKILLS。
# 省略此变量时，Mutation Skill 仍仅限默认连接。
# SKILLS_ALLOW_MUTATION_CONNECTIONS=mysql,analytics

# Mutation execute requires a one-time preview token returned by confirm=false.
# Mutation execute 必须使用 confirm=false 返回的一次性 preview token。
# Tokens are registered in a bounded process-local store and always become
# invalid after server restart, even when a fixed signing secret is configured.
# Token 会登记在有界的进程内 store 中；服务重启后全部失效，即使配置了固定签名密钥也一样。
MUTATION_PREVIEW_TOKEN_TTL_SECONDS=300
# Maximum outstanding unexpired preview tokens. Capacity exhaustion fails closed
# and does not evict valid tokens.
# 未过期 preview token 的最大数量。容量耗尽时 fail closed，不会驱逐仍有效的 token。
MUTATION_PREVIEW_TOKEN_STORE_MAX_ENTRIES=10000
# Optional fixed HMAC key. Keep it private; it does not persist memory-store state.
# 可选的固定 HMAC 密钥。必须保密；它不会持久化进程内 store 的状态。
# MUTATION_PREVIEW_TOKEN_SECRET=change_me_and_keep_private

# Default list_skills() metadata projection: compact, summary, or full
# list_skills() 默认元数据投影：compact、summary 或 full
# compact = lightweight catalog; summary = default discovery metadata;
# full = includes parameter schemas for planning execution.
# compact=轻量目录；summary=默认发现元数据；full=包含用于规划执行的参数 schema。
SKILLS_LIST_DEFAULT_DETAIL=summary

# Default list_skills() availability filtering (1=only currently executable skills,
# 0=full discovered catalog). Developers can override per call with available_only.
# list_skills() 默认可用性过滤（1=仅显示当前可执行 Skill，0=显示完整发现目录）。
# 开发者可通过单次调用的 available_only 参数覆盖该默认值。
SKILLS_LIST_AVAILABLE_ONLY_DEFAULT=1

# Include live table-existence checks in Skills availability/readiness metadata.
# When enabled, available_only=true hides skills whose required tables are missing.
# 在 Skills 可用性/就绪度元数据中加入实时表存在性检查。启用后，
# available_only=true 会隐藏缺少依赖表的 Skill。
SKILLS_CHECK_SCHEMA_ON_LIST=1

# Exclude skills with matching profiles from default discovery and execution.
# Example: hide bundled demo skills in production even if a table named orders exists.
# 从默认发现和执行中排除匹配 profile 的 Skill。例如，即使生产库存在 orders 表，
# 也可以隐藏仓库自带的 demo Skill。
# SKILLS_EXCLUDE_PROFILES=demo

# Skills directory path (relative to project root or absolute)
# Skills 目录路径（相对于项目根目录或使用绝对路径）
# SKILLS_DIR=skills/

# Audit log path for best-effort mutation audit attempts and optional query skill audit (JSONL format).
# best-effort Mutation 审计和可选查询 Skill 审计的日志路径（JSONL 格式）。
# Audit write failures do not block mutation execution; normal tool results expose audit_logged.
# 审计写入失败不会阻止 Mutation 执行；正常工具结果会通过 audit_logged 反馈状态。
# Audit params are truncated for size, not key/value redacted. Do not pass
# secrets, tokens, credentials, or sensitive personal data as skill params.
# 审计参数只做长度截断，不按键值脱敏。不要把 secret、token、凭据或敏感个人数据
# 作为 Skill 参数传入。
# In production, put this file on trusted storage with restricted permissions,
# external rotation, retention, and disk-usage monitoring.
# 生产环境应将日志放在可信存储上并限制权限，使用外部轮转/保留策略，并监控磁盘使用量。
# SKILLS_AUDIT_LOG=skills/_audit.jsonl

# Optional query skill audit. Default is off to avoid logging read-query params.
# 可选的查询 Skill 审计。默认关闭，以避免记录只读查询参数。
SKILLS_AUDIT_QUERIES=0

# =============================================================================
# Optional Tool Telemetry (v3.4.2)
# 可选工具遥测（v3.4.2）
# =============================================================================

# Disabled by default. When enabled, writes one sanitized JSONL line per
# tools/call. The record includes only timestamp, tool_name, execution_ms,
# call_completed, success, error_class, db_type, and safe connection_id when
# available. It never logs SQL text, parameters, returned rows, DSNs, hosts,
# file paths, users, passwords, credentials, or database internals.
# 默认关闭。启用后，每次 tools/call 写入一行脱敏 JSONL。记录只包含时间戳、工具名、
# 执行耗时、调用是否完成、业务是否成功、错误类别、数据库类型和可用时的安全连接 ID。
# 不记录 SQL 文本、参数、返回行、DSN、host、文件路径、用户、密码、凭据或数据库内部信息。
ENABLE_TOOL_TELEMETRY=0

# Local JSONL sink for tool telemetry. Keep this path on trusted local storage;
# while records are sanitized, call timing and tool usage patterns can still be
# operationally sensitive. Use external rotation/retention (for example
# logrotate, platform logging, cron cleanup, or a managed log sink) in production.
# 工具遥测的本地 JSONL 输出路径。请放在可信本地存储上；虽然记录已脱敏，调用时间和
# 工具使用模式仍可能属于敏感运维信息。生产环境请使用外部轮转/保留机制，例如
# logrotate、平台日志、cron cleanup 或托管日志 sink。
# TOOL_TELEMETRY_LOG_PATH=logs/tool_calls.jsonl

# Probability of writing each telemetry record (0.0-1.0). Defaults to 1.0.
# Invalid/NaN/Infinity values fall back to 1.0; out-of-range finite values are
# clamped to the nearest bound.
# 每条遥测记录的写入概率（0.0-1.0），默认 1.0。非法值、NaN 或 Infinity 回退为 1.0；
# 有限但越界的值会被夹到最近边界。
TOOL_TELEMETRY_SAMPLE_RATE=1.0

# Agent identifier for audit logging (used in mutation audit trail)
# 用于审计日志的 Agent 标识（写入 Mutation 审计记录）
# AGENT_ID=my-agent

# Token Optimization: Limit result size to prevent context overflow
# Token 优化：限制结果大小，防止上下文溢出
# Set to 0 to disable truncation (for data export scenarios)
# 设置为 0 可禁用截断（适用于数据导出场景）
# Reference: Google Gemini best practices - token limits
# 参考：Google Gemini 最佳实践——Token 限制
MAX_RESULT_ROWS=100
MAX_RESULT_CHARS=16000
# Raw query(sql) input may be echoed in structured tool payloads and MCP context
# logs for transparency/debugging. Do not put secrets, tokens, credentials, or
# sensitive personal data in SQL literals.
# 原始 query(sql) 输入可能为了透明排障被回显到结构化 payload 和 MCP context 日志。
# 不要在 SQL literal 中放入 secret、token、凭据或敏感个人数据。
MAX_SQL_LENGTH=20000

# Schema Truncation: Limit tables returned by get_full_schema()
# Schema 截断：限制 get_full_schema() 返回的表数量
# Prevents token overflow for large databases (100+ tables)
# 防止大型数据库（100 张以上表）造成 Token 溢出
# Default: 50 tables (estimated ~80K chars max)
# 默认：50 张表（估算最大约 8 万字符）
MAX_SCHEMA_TABLES=50

# Overview Truncation: Limit tables returned by list_tables()
# 概览截断：限制 list_tables() 返回的表数量
# Lightweight overview tool - higher limit than full schema
# 这是轻量级概览工具，限制通常高于完整 Schema
# Default: 100 tables
# 默认：100 张表
MAX_OVERVIEW_TABLES=100
